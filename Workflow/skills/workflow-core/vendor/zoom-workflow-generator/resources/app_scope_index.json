{
  "format_version": 1,
  "resolver": {
    "connector_prefix": "zm.connector_mcp.<app_key>.",
    "one_p_families": {
      "zm.meeting.* | *get_meeting_summary | *search_meeting": "zm.meeting.meeting.meeting_nodes",
      "zm.doc.* | *zoom_doc*": "zm.doc.doc.doc_nodes",
      "zm.tc.*": "zm.tc.tc.team_chat_nodes"
    }
  },
  "source_conversion": {
    "3p": "connector",
    "1p": "workplace",
    "aic": "workplace"
  },
  "apps": {
